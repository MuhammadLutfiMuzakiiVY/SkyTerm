install_ubuntu_skyterm_command() {
    local rootfs="$1"
    local source="$PREFIX/bin/skyterm"
    local destination="$rootfs/usr/local/bin/skyterm"
    local temporary="$destination.skyterm.tmp"

    has_managed_skyterm_command || return 1
    mkdir -p "$rootfs/usr/local/bin" || return 1

    if [ -e "$destination" ] || [ -L "$destination" ]; then
        [ ! -L "$destination" ] || return 2
        if ! is_managed_skyterm_file "$destination"; then
            return 2
        fi
        if [ -x "$destination" ] && [ ! "$source" -nt "$destination" ]; then
            return 0
        fi
    fi

    {
        printf '#!/bin/bash\n'
        sed '1d' "$source"
    } > "$temporary" || {
        rm -f "$temporary"
        return 1
    }

    chmod 0755 "$temporary" && mv -f "$temporary" "$destination" || {
        rm -f "$temporary"
        return 1
    }
    return 0
}

fallback_to_termux() {
    printf '\nSkyTerm could not prepare Ubuntu. Opening the Termux shell instead.\n'
    if has_managed_skyterm_command; then
        print_welcome termux 1
    else
        print_welcome termux 0
    fi
    exec "$PREFIX/bin/bash" -l
}

if ! command -v proot-distro >/dev/null 2>&1; then
    printf 'Preparing Ubuntu support (internet is needed the first time)...\n'
    pkg install -y proot-distro || fallback_to_termux
fi

if ! command -v proot-distro >/dev/null 2>&1; then
    fallback_to_termux
fi

ubuntu_rootfs="$PREFIX/var/lib/proot-distro/containers/ubuntu/rootfs"
legacy_ubuntu_rootfs="$PREFIX/var/lib/proot-distro/installed-rootfs/ubuntu"
if [ ! -x "$ubuntu_rootfs/bin/bash" ] && [ ! -x "$legacy_ubuntu_rootfs/bin/bash" ]; then
    printf 'Installing the Ubuntu command-line environment...\n'
    proot-distro install ubuntu || fallback_to_termux
fi

if [ -x "$ubuntu_rootfs/bin/bash" ]; then
    if install_ubuntu_skyterm_command "$ubuntu_rootfs"; then
        skyterm_command_available=1
    else
        skyterm_command_available=0
    fi
    print_welcome ubuntu "$skyterm_command_available"
    exec proot-distro login --shared-home ubuntu
fi

if [ -x "$legacy_ubuntu_rootfs/bin/bash" ]; then
    if install_ubuntu_skyterm_command "$legacy_ubuntu_rootfs"; then
        skyterm_command_available=1
    else
        skyterm_command_available=0
    fi
    print_welcome ubuntu "$skyterm_command_available"
    exec proot-distro login --shared-home ubuntu
fi

fallback_to_termux
