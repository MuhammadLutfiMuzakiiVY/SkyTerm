#!/data/data/com.termux/files/usr/bin/bash

# SkyTerm keeps the Termux host intact and enters Ubuntu through PRoot-Distro.

SKYTERM_COMMAND_MARKER='# SKYTERM_MANAGED_COMMAND'

is_managed_skyterm_file() {
    local target="$1"
    local line1="" line2=""
    [ -r "$target" ] || return 1
    {
        IFS= read -r line1 && IFS= read -r line2
    } < "$target" 2>/dev/null || return 1
    [ "$line2" = "$SKYTERM_COMMAND_MARKER" ]
}

has_managed_skyterm_command() {
    [ -x "$PREFIX/bin/skyterm" ] || return 1
    [ ! -L "$PREFIX/bin/skyterm" ] || return 1
    is_managed_skyterm_file "$PREFIX/bin/skyterm"
}

